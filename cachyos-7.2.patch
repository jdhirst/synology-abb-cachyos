diff --git a/build-tools/patches/synosnap/configure-tests/feature-tests/Makefile b/build-tools/patches/synosnap/configure-tests/feature-tests/Makefile
--- a/build-tools/patches/synosnap/configure-tests/feature-tests/Makefile
+++ b/build-tools/patches/synosnap/configure-tests/feature-tests/Makefile
@@ -8,7 +8,10 @@ obj-m :=$(OBJ)
 KERNELVERSION ?= $(shell uname -r)
 KDIR := /lib/modules/$(KERNELVERSION)/build
 PWD := $(shell pwd)
-EXTRA_CFLAGS := -g -Werror -I$(src)/../..
+# CachyOS's clang-built kernels promote uninitialised dummy probe arguments to
+# errors.  These probes only test whether an API type-checks, so that diagnostic
+# must not be allowed to turn an existing API into a false negative.
+EXTRA_CFLAGS := -g -Werror -Wno-error=uninitialized -Wno-error=uninitialized-const-pointer -I$(src)/../..
 BUILDDIR ?= $(PWD)/build/$(OBJ)
 BUILDDIR_MAKEFILE ?= $(PWD)/build/$(OBJ)/Makefile
 BUILDDIR_SOURCE ?= $(PWD)/build/$(OBJ)/$(SRC)
diff --git a/build-tools/patches/synosnap/genconfig.sh b/build-tools/patches/synosnap/genconfig.sh
--- a/build-tools/patches/synosnap/genconfig.sh
+++ b/build-tools/patches/synosnap/genconfig.sh
@@ -48,6 +48,10 @@ deb_extract_system_map() {
 
 SYSTEM_MAP_FILE="/lib/modules/${KERNEL_VERSION}/System.map"
 
+# Arch/CachyOS installs the map with the kernel build tree rather than beside
+# the loadable modules.  Check it before falling back to distro-specific paths.
+[ ! -f "$SYSTEM_MAP_FILE" ] && SYSTEM_MAP_FILE="/usr/lib/modules/${KERNEL_VERSION}/build/System.map"
+
 # Use standard location at the /boot
 [ ! -f "$SYSTEM_MAP_FILE" ] && SYSTEM_MAP_FILE="/boot/System.map-${KERNEL_VERSION}"
 if [ ! -f "$SYSTEM_MAP_FILE" ] || [ $(cat "$SYSTEM_MAP_FILE" | wc -l) -lt 10 ]; then

#!/bin/bash
set -euo pipefail

kernelver=${1:?missing target kernel version}
args=()
[[ "${2:-}" == clean ]] && args=(clean)
srcdir=$(cd -- "$(dirname -- "$0")" && pwd)
kernel_config="/usr/lib/modules/${kernelver}/build/include/generated/autoconf.h"

# CachyOS ships both clang-built and GCC-built flavours. Using the compiler
# encoded in each target kernel's configuration is required for DKMS builds of
# all installed kernels, not only the currently running one.
if grep -qx '#define CONFIG_CC_IS_CLANG 1' "$kernel_config"; then
  exec make -C "$srcdir" KERNELVERSION="$kernelver" CC=clang LLVM=1 "${args[@]}"
else
  exec make -C "$srcdir" KERNELVERSION="$kernelver" CC=gcc "${args[@]}"
fi
